		"protectedFanout": {
			"enabled": false,
			"enforcement": null,
			"rules": []
		},
		"featureReachability": {
			"enabled": false,
			"definitionsPath": null,
			"consumerRoots": [],
			"consumerFilePattern": null,
			"journeyRoots": [],
			"journeyFilePattern": null,
			"definitionPattern": null,
			"journeyPattern": null,
			"exemptionPattern": null
		}
	},
	"github": {
		"issueMutation": true,
