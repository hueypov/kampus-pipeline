				"code": {
					"includePatterns": ["^(src|app|apps|packages|lib|server|infra|scripts|tests?)/"],
					"excludePatterns": []
				},
				"docs": {
					"includePatterns": ["^(docs|documentation|\\.decisions|\\.patterns)/|(^|/)README\\.md$|\\.md$"],
					"excludePatterns": ["(^|/)(skills|agents)/", "^\\.codex-plugin/", "^(src|app|apps|packages|lib|server|infra|scripts|tests?)/"]
				},
				"skills": {
					"includePatterns": ["(^|/)(skills|agents)/", "^\\.codex-plugin/", "^claude-plugins/[^/]+/evals/"],
					"excludePatterns": []
				},
				"design": {
					"includePatterns": [],
					"excludePatterns": []
				}
			},
			"trivialDiff": {
				"enabled": false,
				"maxChangedLines": 20,
				"protectedPaths": []
			}
		},
		"cliCompatibility": {
			"enabled": false,
			"targetRepository": null,
			"realGhPath": null,
			"pathShim": {
				"enabled": false
			},
			"graphql": {
				"mode": "passthrough",
				"blockVerbs": [],
