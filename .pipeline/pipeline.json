	"managedHooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.pipeline/toolkit/claude-plugins/pipeline/hooks/install.sh\"",
						"timeout": 120
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Read|Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.pipeline/toolkit/claude-plugins/pipeline/hooks/guard.sh worktree-guard pre-file\""
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.pipeline/toolkit/claude-plugins/pipeline/hooks/guard.sh worktree-guard pre-bash\""
					}
				]
			},
			{
				"matcher": "EnterWorktree",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.pipeline/toolkit/claude-plugins/pipeline/hooks/guard.sh worktree-guard pre-enter\""
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.pipeline/toolkit/claude-plugins/pipeline/hooks/guard.sh worktree-guard reap\""
					}
				]
			}
		],
		"WorktreeCreate": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/.pipeline/toolkit/claude-plugins/pipeline/hooks/create-worktree.sh\"",
						"timeout": 600
					}
				]
			}
		]
	}
}
