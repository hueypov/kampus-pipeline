		"check:workflow-catalog": "node --experimental-strip-types src/generate-workflow-catalog.ts --check"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"vitest": "catalog:"
	}
}
